{
  "name": "ai-psych",
  "version": "1.0.0",
  "private": true,
  "description": "AI Psych — a hand-drawn party game where the AI knows a little too much. Pure static site, peer-to-peer over WebRTC.",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-force-exit --test-concurrency=1 tests/e2e/*.e2e.js",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "signal": "npx --yes peer --port 9000"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "peer": "^1.0.2",
    "playwright": "^1.55.0",
    "ws": "^8.18.0"
  }
}
